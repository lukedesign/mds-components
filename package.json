    "storybook": "storybook dev -p 6007",
    "storybook:build": "storybook build -o storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
